# Run make configure to generate .env with random development credentials.
# Server runtime values. Never prefix secrets with NEXT_PUBLIC_.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8100/api/v1
API_DEV_PORT=8100
PORTFOLIO_DB_PORT=55433
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_VALUE
DATABASE_URL=postgresql+psycopg://portfolio:REPLACE_WITH_RANDOM_VALUE@127.0.0.1:55433/portfolio
MEDIA_BACKEND=local
MEDIA_ROOT=.data/media
CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ABUSE_HMAC_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
SESSION_ABSOLUTE_SECONDS=43200
SESSION_IDLE_SECONDS=3600
TRUSTED_PROXY_CIDRS=
CONTACT_RETENTION_DAYS=180
CONTACT_IP_LIMIT=5
CONTACT_SITE_LIMIT=100
LOG_LEVEL=INFO
# SMTP is optional and disabled when SMTP_HOST is empty. No outgoing email by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_NOTIFY_TO=
