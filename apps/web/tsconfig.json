{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "vite/client"
    ],
    "rootDirs": [
      ".",
      "./.react-router/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "*.ts",
    ".react-router/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}
