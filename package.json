{
  "name": "gagandeep-portfolio",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @portfolio/web dev",
    "build": "pnpm --filter @portfolio/web build",
    "typecheck": "pnpm --filter @portfolio/web typecheck",
    "lint": "pnpm --filter @portfolio/web lint",
    "test": "pnpm --filter @portfolio/web test",
    "e2e": "playwright test",
    "contracts": "node apps/web/scripts/contracts.mjs",
    "contracts:check": "node apps/web/scripts/contracts.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.0",
    "openapi-typescript": "7.13.0"
  }
}
